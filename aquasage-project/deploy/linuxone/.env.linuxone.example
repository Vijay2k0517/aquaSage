# AquaSage IBM LinuxONE Production Configuration Template
# Copy to .env in your deployment directory and replace placeholders

# Runtime & Environment
ENVIRONMENT=production
PROJECT_NAME=AquaSage Rural Infrastructure Monitor
VERSION=1.0.0
API_PORT=8000

# Security (CRITICAL: Generate strong random secrets before deploying)
# e.g.: openssl rand -hex 32
SECRET_KEY=replace_with_64_character_hex_production_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Connectivity (PostgreSQL on LinuxONE)
POSTGRES_USER=aquasage_admin
POSTGRES_PASSWORD=replace_with_secure_database_password
POSTGRES_DB=aquasage_db
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aquasage_admin:replace_with_secure_database_password@postgres:5432/aquasage_db

# Caching & Message Queue (Redis on LinuxONE)
ENABLE_REDIS=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["https://aquasage.yourorg.gov","http://localhost:8081"]

# Telemetry & Operating Modes
# Set to 'false' in production when ingesting actual ESP32 sensor hardware
SIMULATOR_MODE=false
DEFAULT_TANK_HEIGHT_CM=30.0

# IBM Snap ML Acceleration Config
OMP_NUM_THREADS=4
AQUASAGE_MODEL_PATH=/app/models/future_risk_model.joblib
LSTM_MODEL_PATH=/app/phase3a/models/lstm_predictor.pth
